# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=seu-jwt-secret-do-supabase

# Servidor
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# WhatsApp (Baileys) — diretório onde as credenciais de sessão são salvas
# No Railway: configure um volume persistente e aponte aqui
# Se omitido, usa ./baileys-auth (funciona em dev, mas perde sessão no redeploy)
BAILEYS_AUTH_DIR=/data/baileys-auth

# E-mail (SendGrid) — envio de credenciais para novos profissionais
# Railway bloqueia portas SMTP; usamos SendGrid HTTP API como alternativa
# 1. Criar conta grátis em sendgrid.com
# 2. Settings → Sender Authentication → Single Sender Verification → verificar o e-mail remetente
# 3. Settings → API Keys → Create API Key → copiar aqui
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM=seuemail@gmail.com
