# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=seu-jwt-secret-do-supabase

# Servidor
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# WhatsApp (Baileys) — diretório onde as credenciais de sessão são salvas
# No Railway: configure um volume persistente e aponte aqui
# Se omitido, usa ./baileys-auth (funciona em dev, mas perde sessão no redeploy)
BAILEYS_AUTH_DIR=/data/baileys-auth

# E-mail (Resend) — envio de credenciais para novos profissionais
# Railway bloqueia portas SMTP; usamos Resend (HTTP API) como alternativa
# Criar conta grátis em resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
