# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=seu-jwt-secret-do-supabase

# Servidor
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# WhatsApp (Baileys) — diretório onde as credenciais de sessão são salvas
# No Railway: configure um volume persistente e aponte aqui
# Se omitido, usa ./baileys-auth (funciona em dev, mas perde sessão no redeploy)
BAILEYS_AUTH_DIR=/data/baileys-auth

# E-mail (SMTP) — envio de credenciais para novos profissionais
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
#        SMTP_USER=seuemail@gmail.com, SMTP_PASS=senha-de-app (não a senha da conta)
#        Gerar em: myaccount.google.com > Segurança > Senhas de app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-senha-de-app-gmail
